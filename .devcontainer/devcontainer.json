{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "postCreateCommand": "git config --global user.name 'taka5hi' && git config --global user.email 'n.takashi930@gmail.com'",
    "mounts": [
        "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/python:1": {
            "installTools": true,
            "toolsToInstall": "uv"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "ms-python.python"
            ]
        }
    }
}